# Gemini (Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=tutaj_wklej_swoj_klucz
ENABLE_SEARCH_GROUNDING=false

# Supabase — service role jest używany wyłącznie po stronie serwera.
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tutaj_wklej_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=tutaj_wklej_service_role_key

# Opcjonalne zabezpieczenie endpointu. Vercel Cron wysyła ten sekret jako Bearer token.
CRON_SECRET=

# Opcjonalnie można podmienić źródło wiadomości na dowolny kanał RSS.
NEWS_RSS_URL=https://news.google.com/rss?hl=pl&gl=PL&ceid=PL:pl
